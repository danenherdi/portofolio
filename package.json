    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "firebase": "^12.10.0",
