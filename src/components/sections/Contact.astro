---

---

<section
  id="contact"
  class="min-h-[70vh] w-full flex items-center justify-center relative px-6 py-24"
>
  <!-- Background Accents -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-cyan-900/10 blur-[150px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-2xl z-10 w-full text-center flex flex-col items-center">
    <h3
      class="text-sm font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-2"
    >
      04. Connection
    </h3>
    <h2
      class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 text-transparent bg-clip-text bg-linear-to-r from-slate-800 to-slate-500 dark:from-cloud-white dark:to-slate-400 pb-2"
    >
      Let's Build Together
    </h2>
    <p
      class="text-slate-600 dark:text-white/70 text-lg mb-12 max-w-xl leading-relaxed"
    >
      Continuously exploring new opportunities in cloud architecture and backend
      development. Whether you have a question or a project proposal, my inbox
      is open.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
      <a
        href="mailto:danendra.herdiansyah12@gmail.com"
        class="px-8 py-4 bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/30 rounded-xl hover:bg-cyan-100 dark:hover:bg-cyan-500/20 hover:border-cyan-300 dark:hover:border-cyan-400 transition-all shadow-[0_0_20px_rgba(34,211,238,0.1)] font-medium text-lg flex items-center gap-3 w-full sm:w-auto justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
        >
        Say Hello
      </a>
    </div>

    <!-- Social Links -->
    <div class="mt-16 flex gap-6 items-center justify-center">
      <a
        href="https://github.com/danenherdi"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-500 dark:text-white/60 hover:text-cyan-600 dark:hover:text-cyan-400 hover:-translate-y-1 transition-all"
        aria-label="GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
        >
      </a>
      <a
        href="https://linkedin.com/in/danendra-herdiansyah"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-500 dark:text-white/60 hover:text-cyan-600 dark:hover:text-cyan-400 hover:-translate-y-1 transition-all"
        aria-label="LinkedIn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
          ></path><rect width="4" height="12" x="2" y="9"></rect><circle
            cx="4"
            cy="4"
            r="2"></circle></svg
        >
      </a>
      <a
        href="https://instagram.com/danen_herdi"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-500 dark:text-white/60 hover:text-cyan-600 dark:hover:text-cyan-400 hover:-translate-y-1 transition-all"
        aria-label="Instagram"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path
            d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
            x1="17.5"
            x2="17.51"
            y1="6.5"
            y2="6.5"></line></svg
        >
      </a>
    </div>
  </div>
</section>
