---
import { getCollection, type CollectionEntry } from "astro:content";
import TimelineItem from "../TimelineItem.svelte";

// Fetch all experience entries
const allExperience = await getCollection("experience");

// Organize into categories
const professionalWork = allExperience
  .filter(
    (entry: CollectionEntry<"experience">) =>
      entry.data.category === "Professional Work",
  )
  .sort(
    (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
      {
        const dateDiff = b.data.startDate.valueOf() - a.data.startDate.valueOf();
        if (dateDiff !== 0) return dateDiff;
        return (a.data.order ?? 99) - (b.data.order ?? 99);
      }
    );

const nonFormalEducation = allExperience
  .filter(
    (entry: CollectionEntry<"experience">) =>
      entry.data.category === "Non-Formal Education",
  )
  .sort(
    (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
      {
        const dateDiff = b.data.startDate.valueOf() - a.data.startDate.valueOf();
        if (dateDiff !== 0) return dateDiff;
        return (a.data.order ?? 99) - (b.data.order ?? 99);
      }
  );

const certifications = allExperience
  .filter(
    (entry: CollectionEntry<"experience">) =>
      entry.data.category === "Certifications",
  )
  .sort(
    (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
      {
        const dateDiff = b.data.startDate.valueOf() - a.data.startDate.valueOf();
        if (dateDiff !== 0) return dateDiff;
        return (a.data.order ?? 99) - (b.data.order ?? 99);
      }
  );

// Helper function to format dates
function formatDateRange(start: Date, end?: Date) {
  const options: Intl.DateTimeFormatOptions = {
    month: "short",
    year: "numeric",
  };
  const startStr = start.toLocaleDateString("en-US", options);
  const endStr = end ? end.toLocaleDateString("en-US", options) : "Present";
  return `${startStr} – ${endStr}`;
}
---

<section
  id="experience"
  class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
>
  <!-- Background Accents -->
  <div
    class="absolute top-0 right-0 w-1/3 h-1/2 bg-purple-900/10 blur-[120px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-4xl z-10 w-full">
    <h3
      class="text-sm font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-2 mt-12 md:mt-0"
    >
      01. Journey
    </h3>
    <h2
      class="text-3xl md:text-5xl font-extrabold tracking-tight mb-16 text-transparent bg-clip-text bg-linear-to-r from-slate-800 to-slate-500 dark:from-cloud-white dark:to-slate-400"
    >
      Professional Experience & Education
    </h2>

    <!-- Professional Work Timeline -->
    <h4
      class="text-xl md:text-2xl font-bold mb-8 text-cyan-800 dark:text-cyan-200 border-l-4 border-cyan-600 dark:border-cyan-500 pl-4"
    >
      Professional Work
    </h4>
    <div class="relative mb-20">
      <!-- Global Timeline Line (Mobile) -->
      <div
        class="md:hidden absolute left-[15px] top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50"
      >
      </div>
      <!-- Global Timeline Line (Desktop) -->
      <div
        class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50 -translate-x-1/2"
      >
      </div>

      <div class="flex flex-col gap-12">
        {
          professionalWork.map(async (entry: any, index: number) => {
            const { Content } = await entry.render();
            return (
              <TimelineItem
                title={entry.data.title}
                organization={entry.data.organization}
                dateRange={formatDateRange(
                  entry.data.startDate,
                  entry.data.endDate,
                )}
                active={index === 0}
              >
                <Content />
              </TimelineItem>
            );
          })
        }
      </div>
    </div>

    <!-- Non-Formal Education Timeline -->
    <h4
      class="text-xl md:text-2xl font-bold mb-8 text-purple-800 dark:text-purple-300 border-l-4 border-purple-600 dark:border-purple-500 pl-4 mt-8"
    >
      Non-Formal Education
    </h4>
    <div class="relative">
      <!-- Global Timeline Line (Mobile) -->
      <div
        class="md:hidden absolute left-[15px] top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50"
      >
      </div>
      <!-- Global Timeline Line (Desktop) -->
      <div
        class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50 -translate-x-1/2"
      >
      </div>

      <div class="flex flex-col gap-12">
        {
          nonFormalEducation.map(async (entry: any) => {
            const { Content } = await entry.render();
            return (
              <TimelineItem
                title={entry.data.title}
                organization={entry.data.organization}
                dateRange={formatDateRange(
                  entry.data.startDate,
                  entry.data.endDate,
                )}
                active={false}
              >
                <Content />
              </TimelineItem>
            );
          })
        }
      </div>
    </div>

    <!-- Certifications Timeline -->
    {certifications.length > 0 && (
      <>
        <h4
          class="text-xl md:text-2xl font-bold mb-8 text-emerald-800 dark:text-emerald-300 border-l-4 border-emerald-600 dark:border-emerald-500 pl-4 mt-16"
        >
          Certifications
        </h4>
        <div class="relative">
          <!-- Global Timeline Line (Mobile) -->
          <div
            class="md:hidden absolute left-[15px] top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50"
          >
          </div>
          <!-- Global Timeline Line (Desktop) -->
          <div
            class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700/50 -translate-x-1/2"
          >
          </div>

          <div class="flex flex-col gap-12">
            {
              certifications.map(async (entry: any) => {
                const { Content } = await entry.render();
                return (
                  <TimelineItem
                    title={entry.data.title}
                    organization={entry.data.organization}
                    dateRange={formatDateRange(
                      entry.data.startDate,
                      entry.data.endDate,
                    )}
                    active={false}
                  >
                    <Content />
                  </TimelineItem>
                );
              })
            }
          </div>
        </div>
      </>
    )}
  </div>
</section>
