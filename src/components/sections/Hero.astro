---
import ProfileImage from "../ProfileImage.svelte";
---

<section
  id="about"
  class="min-h-screen w-full flex items-center justify-center relative overflow-hidden px-6 pt-20"
>
  <!-- Background Decoration (Orbiter placeholders) -->
  <div
    class="absolute top-0 sm:top-1/4 left-0 sm:left-1/4 w-64 sm:w-96 h-64 sm:h-96 bg-cyan-600/20 rounded-full blur-[80px] sm:blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-0 sm:right-1/4 w-64 sm:w-96 h-64 sm:h-96 bg-purple-600/20 rounded-full blur-[80px] sm:blur-[100px] pointer-events-none"
  >
  </div>

  <div
    class="max-w-4xl z-10 w-full flex flex-col md:flex-row gap-8 lg:gap-16 items-center md:items-start text-center md:text-left mt-8 md:mt-0"
  >
    <!-- Profile Image Column (Mobile top, Desktop Left) -->
    <div class="w-48 h-48 md:w-64 md:h-64 shrink-0 -mt-10 md:mt-2 lg:mt-6">
      <ProfileImage
        client:load
        className="w-full h-full"
        imagePath="public/Foto_Profil.jpg"
      />
    </div>

    <!-- Text Column -->
    <div
      class="flex flex-col gap-6 md:gap-6 flex-1 items-center md:items-start"
    >
      <!-- Eyebrow text -->
      <p
        class="text-cyan-600 dark:text-cyan-400 font-mono text-sm md:text-base uppercase tracking-widest"
      >
        System Architecture & Optimization
      </p>

      <h1
        class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-tight text-slate-900 dark:text-white w-full"
      >
        Danendra <br class="hidden sm:block" />
        <span
          class="text-transparent bg-clip-text bg-linear-to-r from-cyan-600 to-purple-600 dark:from-cyan-400 dark:to-purple-500 inline-block pb-2"
        >
          Herdiansyah
        </span>
      </h1>

      <h2
        class="text-xl md:text-2xl text-slate-600 dark:text-slate-300 font-medium max-w-2xl mt-4 leading-relaxed tracking-wide"
      >
        Cloud Computing & Distributed Systems Engineer.
      </h2>

      <p
        class="text-lg text-slate-600 dark:text-white/70 max-w-2xl mt-2 leading-relaxed"
      >
        Computer Science graduate from Universitas Indonesia (GPA 3.58) with
        experience across the full engineering stack, from designing scalable
        backend services to managing cloud infrastructure and distributed
        systems. I've worked in academic research, industry-sponsored programs
        (such as Bangkit Academy by Google, GoTo, and Traveloka), and end-to-end product delivery, and I bring the same attention to detail to both
        exploratory research and production-ready engineering.
      </p>

      <div
        class="mt-8 flex gap-4 w-full md:w-auto justify-center md:justify-start"
      >
        <a
          href="#projects"
          class="px-6 py-3 bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/30 rounded-lg hover:bg-cyan-100 dark:hover:bg-cyan-500/20 hover:border-cyan-300 dark:hover:border-cyan-400 transition-all shadow-[0_0_15px_rgba(34,211,238,0.15)] font-medium text-sm md:text-base text-center flex-1 md:flex-none"
        >
          View Projects
        </a>
        <a
          href="#contact"
          class="px-6 py-3 bg-slate-100 dark:bg-white/5 text-slate-800 dark:text-white border border-slate-200 dark:border-white/10 rounded-lg hover:bg-slate-200 dark:hover:bg-white/10 transition-all font-medium text-sm md:text-base text-center flex-1 md:flex-none"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </div>
</section>
