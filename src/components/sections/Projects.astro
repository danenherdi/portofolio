---
import { getCollection } from "astro:content";
import ProjectCard from "../ProjectCard.svelte";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort(
  (a: any, b: any) => a.data.order - b.data.order,
);
---

<section
  id="projects"
  class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
>
  <!-- Background Accents -->
  <div
    class="absolute bottom-0 left-0 w-1/3 h-1/2 bg-cyan-900/10 blur-[120px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-5xl z-10 w-full">
    <h3
      class="text-sm font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-2 mt-12 md:mt-0"
    >
      02. Work
    </h3>
    <h2
      class="text-3xl md:text-5xl font-extrabold tracking-tight mb-16 text-transparent bg-clip-text bg-linear-to-r from-slate-800 to-slate-500 dark:from-cloud-white dark:to-slate-400"
    >
      Featured Projects
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        sortedProjects.map(async (project: any) => {
          const { Content } = await project.render();
          return (
            <ProjectCard
              title={project.data.title}
              tagline={project.data.tagline}
              tags={project.data.tags}
              metrics={project.data.metrics}
              repoUrl={project.data.repoUrl}
              demoUrl={project.data.demoUrl}
            >
              <Content />
            </ProjectCard>
          );
        })
      }
    </div>
  </div>
</section>
