---
import { getCollection } from "astro:content";
import TechStackGrid from "../TechStackGrid.svelte";

const allSkills = await getCollection("skills");
const sortedSkills = allSkills.sort(
  (a: any, b: any) => a.data.order - b.data.order,
);
---

<section
  id="skills"
  class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
>
  <!-- Background Accents -->
  <div
    class="absolute top-1/4 left-0 w-1/4 h-1/2 bg-cyan-900/10 blur-[120px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-5xl z-10 w-full">
    <h3
      class="text-sm font-mono text-purple-600 dark:text-purple-400 uppercase tracking-widest mb-2 mt-12 md:mt-0"
    >
      03. Engine Room
    </h3>
    <h2
      class="text-3xl md:text-5xl font-extrabold tracking-tight mb-16 text-transparent bg-clip-text bg-linear-to-r from-slate-800 to-slate-500 dark:from-cloud-white dark:to-slate-400"
    >
      Technical Arsenal
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        sortedSkills.map((skill: any) => (
          <TechStackGrid
            category={skill.data.category}
            items={skill.data.items}
          />
        ))
      }
    </div>
  </div>
</section>
