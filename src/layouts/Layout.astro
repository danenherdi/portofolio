---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Danendra Herdiansyah | Cloud Computing & Distributed Systems Engineer.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Prevent FOUC: Apply theme before render -->
    <script is:inline>
      function initTheme() {
        const stored = localStorage.getItem("theme");
        let theme = "dark"; // default to dark for tech aesthetics

        if (stored && (stored === "dark" || stored === "light")) {
          theme = stored;
        } else if (
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches
        ) {
          theme = "light";
        }

        document.documentElement.setAttribute("data-theme", theme);
      }

      initTheme();
    </script>
  </head>
  <body
    class="flex flex-col min-h-screen selection:bg-cyan-500/30 selection:text-cyan-50"
  >
    <!-- Navbar placeholder could go here eventually -->

    <slot />

    <!-- Handle theme changes on navigation (Astro View Transitions) -->
    <script>
      // Setup simple listener for view transitions if added later
      document.addEventListener("astro:after-swap", () => {
        const stored = localStorage.getItem("theme");
        let theme = "dark";

        if (stored && (stored === "dark" || stored === "light")) {
          theme = stored;
        } else if (
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches
        ) {
          theme = "light";
        }

        document.documentElement.setAttribute("data-theme", theme);
      });
    </script>
  </body>
</html>
