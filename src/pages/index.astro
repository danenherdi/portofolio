---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.svelte";

// Sections
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Projects from "../components/sections/Projects.astro";
import TechStack from "../components/sections/TechStack.astro";
import Contact from "../components/sections/Contact.astro";
---

<Layout title="Danendra Herdiansyah | Cloud Engineer">
  <!-- Navbar (Responsive/Floating) -->
  <div
    class="fixed top-4 md:top-6 left-0 right-0 w-full z-50 flex justify-center px-4 md:px-6 pointer-events-none"
  >
    <header
      id="main-nav"
      class="w-full max-w-2xl px-5 md:px-6 py-3 rounded-2xl md:rounded-full flex flex-col md:flex-row justify-between items-center glass-card border border-slate-200 dark:border-white/20 bg-white/80 dark:bg-white/5 shadow-[0_8px_32px_rgba(0,0,0,0.05)] dark:shadow-2xl pointer-events-auto transition-all duration-300"
    >
      <!-- Top Row (Always visible) -->
      <div class="flex justify-between items-center w-full md:w-auto">
        <a
          href="#"
          class="font-bold text-lg tracking-tighter block hover:opacity-80 transition-opacity"
        >
          <span
            class="text-transparent bg-clip-text bg-linear-to-r from-cyan-600 to-purple-600 dark:from-cyan-400 dark:to-purple-500"
            >Danen</span
          >
          <span class="text-slate-600 dark:text-white dark:opacity-80"
            >.Herdi</span
          >
        </a>

        <!-- Mobile Controls -->
        <div class="flex items-center gap-2 md:hidden">
          <ThemeToggle client:load />
          <button
            id="mobile-menu-btn"
            class="p-2 -mr-2 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
            aria-label="Toggle Menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="menu-icon"
              ><line x1="4" x2="20" y1="12" y2="12"></line><line
                x1="4"
                x2="20"
                y1="6"
                y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="close-icon hidden"
              ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
            >
          </button>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav
        id="nav-links"
        class="flex-col md:flex-row gap-4 md:gap-6 text-sm font-medium items-center w-full md:w-auto hidden md:flex mt-4 md:mt-0 pt-4 md:pt-0 border-t border-slate-200 dark:border-white/10 md:border-none pb-2 md:pb-0"
      >
        <a
          href="#about"
          class="nav-link w-full md:w-auto text-center py-2 md:py-0 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 hover:opacity-100 transition-colors"
          >About</a
        >
        <a
          href="#experience"
          class="nav-link w-full md:w-auto text-center py-2 md:py-0 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Experience</a
        >
        <a
          href="#projects"
          class="nav-link w-full md:w-auto text-center py-2 md:py-0 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Projects</a
        >
        <a
          href="#skills"
          class="nav-link w-full md:w-auto text-center py-2 md:py-0 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Skills</a
        >
        <a
          href="#contact"
          class="nav-link w-full md:w-auto text-center py-2 md:py-0 text-slate-600 dark:text-white/80 hover:text-cyan-600 dark:hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Contact</a
        >
        <div
          class="hidden md:block w-px h-4 bg-slate-300 dark:bg-white/20 mx-1 md:mx-2"
        >
        </div>
        <div class="hidden md:block">
          <ThemeToggle client:load />
        </div>
      </nav>
    </header>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("mobile-menu-btn");
      const nav = document.getElementById("nav-links");
      const menuIcon = btn?.querySelector(".menu-icon");
      const closeIcon = btn?.querySelector(".close-icon");
      const navLinks = document.querySelectorAll(".nav-link");

      function toggleMenu() {
        nav?.classList.toggle("hidden");
        nav?.classList.toggle("flex");
        menuIcon?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
      }

      btn?.addEventListener("click", toggleMenu);

      // Close menu when clicking a link on mobile
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            toggleMenu();
          }
        });
      });
    });
  </script>

  <main
    class="flex flex-col items-center w-full text-slate-800 dark:text-cloud-white"
  >
    <Hero />
    <Experience />
    <Projects />
    <TechStack />
    <Contact />
  </main>

  <footer
    class="w-full py-8 text-center text-slate-500 dark:text-white/50 text-sm border-t border-slate-200 dark:border-white/5 mt-auto"
  >
    <p>&copy; 2026 Danendra Herdiansyah. Designed & Built with Astro.</p>
  </footer>
</Layout>
