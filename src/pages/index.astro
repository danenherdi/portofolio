---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.svelte";
---

<Layout title="Danendra Herdiansyah | Cloud Engineer">
  <!-- Navbar (Minimalist/Floating) -->
  <div
    class="fixed top-6 left-0 right-0 w-full z-50 flex justify-center px-4 md:px-6 pointer-events-none"
  >
    <header
      class="w-full max-w-2xl px-6 py-3 rounded-full flex flex-col md:flex-row justify-between items-center glass-card border border-white/20 bg-white/5 shadow-2xl pointer-events-auto transition-transform duration-300 gap-4 md:gap-0"
    >
      <div class="font-bold text-lg tracking-tighter hidden md:block">
        <span
          class="text-transparent bg-clip-text bg-linear-to-r from-cyan-400 to-purple-500"
          >Danen</span
        ><span class="opacity-80">.Herdi</span>
      </div>
      <nav
        class="flex gap-4 md:gap-6 text-sm font-medium items-center justify-center w-full md:w-auto"
      >
        <a
          href="#about"
          class="opacity-80 hover:text-cyan-400 hover:opacity-100 transition-colors"
          >About</a
        >
        <a
          href="#experience"
          class="opacity-80 hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Experience</a
        >
        <a
          href="#projects"
          class="opacity-80 hover:text-cyan-400 hover:opacity-100 transition-colors"
          >Projects</a
        >
        <a
          href="#skills"
          class="opacity-80 hover:text-cyan-400 hover:opacity-100 transition-colors hidden sm:block"
          >Skills</a
        >
        <a
          href="#contact"
          class="opacity-80 hover:text-cyan-400 hover:opacity-100 transition-colors hidden sm:block"
          >Contact</a
        >
        <div class="w-px h-4 bg-white/20 mx-1 md:mx-2"></div>
        <ThemeToggle client:load />
      </nav>
    </header>
  </div>

  <main class="flex flex-col items-center w-full">
    <!-- HERO / ABOUT ME SECTION -->
    <section
      id="about"
      class="min-h-screen w-full flex items-center justify-center relative overflow-hidden px-6 pt-20"
    >
      <!-- Background Decoration (Orbiter placeholders) -->
      <div
        class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-600/20 rounded-full blur-[100px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-[100px] pointer-events-none"
      >
      </div>

      <div class="max-w-4xl z-10 w-full flex flex-col gap-6">
        <!-- Eyebrow text -->
        <p
          class="text-cyan-400 font-mono text-sm uppercase tracking-widest pl-1"
        >
          System Architecture & Optimization
        </p>

        <h1
          class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight"
        >
          Danendra <br />
          <span
            class="text-transparent bg-clip-text bg-linear-to-r from-cyan-400 to-purple-500"
          >
            Herdiansyah
          </span>
        </h1>

        <h2
          class="text-xl md:text-2xl text-slate-300 font-medium max-w-2xl mt-4 leading-relaxed tracking-wide"
        >
          Cloud Computing & Distributed Systems Engineer.
        </h2>

        <p class="text-lg opacity-70 max-w-2xl mt-2 leading-relaxed">
          Computer Science graduate from Universitas Indonesia, specializing in
          building and optimizing highly available IT infrastructure.
          Experienced with Kubernetes, AWS, and GCP, architecting solutions that
          scale automatically and operate efficiently.
        </p>

        <div class="mt-8 flex gap-4">
          <a
            href="#projects"
            class="px-6 py-3 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-lg hover:bg-cyan-500/20 hover:border-cyan-400 transition-all shadow-[0_0_15px_rgba(34,211,238,0.15)] font-medium"
          >
            View Projects
          </a>
          <a
            href="#contact"
            class="px-6 py-3 bg-white/5 text-white border border-white/10 rounded-lg hover:bg-white/10 transition-all font-medium"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </section>

    <!-- EXPERIENCE SECTION -->
    <section
      id="experience"
      class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
    >
      <div class="max-w-4xl z-10 w-full">
        <h3
          class="text-sm font-mono text-cyan-400 uppercase tracking-widest mb-2"
        >
          01. Journey
        </h3>
        <h2 class="text-3xl md:text-5xl font-bold mb-12">
          Professional Experience & Education
        </h2>

        <!-- Placeholder Box -->
        <div
          class="w-full h-96 glass-card border border-white/10 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-md"
        >
          <p class="opacity-50 font-mono">
            [ Experience Timeline Placeholder ]
          </p>
        </div>
      </div>
    </section>

    <!-- PROJECTS SECTION -->
    <section
      id="projects"
      class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
    >
      <div class="max-w-5xl z-10 w-full">
        <h3
          class="text-sm font-mono text-cyan-400 uppercase tracking-widest mb-2"
        >
          02. Work
        </h3>
        <h2 class="text-3xl md:text-5xl font-bold mb-12">Featured Projects</h2>

        <!-- Placeholder Box -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div
            class="w-full h-80 glass-card border border-white/10 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-md"
          >
            <p class="opacity-50 font-mono">[ Project Card 1 Placeholder ]</p>
          </div>
          <div
            class="w-full h-80 glass-card border border-white/10 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-md"
          >
            <p class="opacity-50 font-mono">[ Project Card 2 Placeholder ]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TECH STACK SECTION -->
    <section
      id="skills"
      class="min-h-screen w-full flex items-center justify-center relative px-6 py-24"
    >
      <div class="max-w-4xl z-10 w-full">
        <h3
          class="text-sm font-mono text-purple-400 uppercase tracking-widest mb-2"
        >
          03. Engine Room
        </h3>
        <h2 class="text-3xl md:text-5xl font-bold mb-12">Technical Arsenal</h2>

        <!-- Placeholder Box -->
        <div
          class="w-full h-64 glass-card border border-white/10 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-md"
        >
          <p class="opacity-50 font-mono">[ Tech Stack Grid Placeholder ]</p>
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section
      id="contact"
      class="min-h-[70vh] w-full flex items-center justify-center relative px-6 py-24"
    >
      <div class="max-w-2xl z-10 w-full text-center">
        <h3
          class="text-sm font-mono text-cyan-400 uppercase tracking-widest mb-2"
        >
          04. Connection
        </h3>
        <h2 class="text-4xl md:text-6xl font-bold mb-6">
          Let's Build Together
        </h2>
        <p class="opacity-70 text-lg mb-12">
          Continuously exploring new opportunities in cloud architecture and
          backend development. Whether you have a question or a project
          proposal, my inbox is open.
        </p>

        <!-- Placeholder Box -->
        <div
          class="w-full h-32 glass-card border border-white/10 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-md text-center max-w-sm mx-auto"
        >
          <p class="opacity-50 font-mono">
            [ Contact Links / Form Placeholder ]
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer
    class="w-full py-8 text-center opacity-50 text-sm border-t border-white/5 mt-auto"
  >
    <p>&copy; 2026 Danendra Herdiansyah. Designed & Built with Astro.</p>
  </footer>
</Layout>
